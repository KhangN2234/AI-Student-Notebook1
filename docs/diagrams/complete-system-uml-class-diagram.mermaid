%% ========================================
%% RELATIONSHIPS - DOMAIN MODELS
%% ========================================

    User "1" *-- "*" Note : owns
    User "1" *-- "*" Folder : owns
    User "1" *-- "1" ReviewSchedule : has
    Folder "1" *-- "*" Note : contains
    Note "1" *-- "*" ReviewSession : generates
    ReviewSchedule "*" -- "*" ReviewSession : schedules

%% ========================================
%% RELATIONSHIPS - REPOSITORIES
%% ========================================

    UserRepository --> User : manages
    NoteRepository --> Note : manages
    FolderRepository --> Folder : manages
    ReviewSessionRepository --> ReviewSession : manages
    ReviewScheduleRepository --> ReviewSchedule : manages

%% ========================================
%% RELATIONSHIPS - SERVICES
%% ========================================

    ReviewSchedulerService --> ReviewScheduleRepository : uses
    ReviewSchedulerService --> ReviewSessionRepository : uses
    ReviewSchedulerService --> NoteRepository : uses

%% ========================================
%% RELATIONSHIPS - FRONTEND COMPONENTS
%% ========================================

    AppLayout --> DashboardPage : contains
    AppLayout --> NoteDetailPage : contains
    AppLayout --> NotesInputPage : contains
    AppLayout --> QuestionsPage : contains
    AppLayout --> CalendarPage : contains
    AppLayout --> ProgressTrackingPage : contains
    
    DashboardPage --> FoldersSidebar : contains
    DashboardPage --> NoteCard : contains
    FoldersSidebar --> FolderItem : contains
    
    DashboardPage --> APIService : uses
    NoteDetailPage --> APIService : uses
    NotesInputPage --> APIService : uses
    QuestionsPage --> APIService : uses
    CalendarPage --> APIService : uses
    ProgressTrackingPage --> APIService : uses
    
    APIService --|> AuthService : extends
    FolderItem --> APIService : uses
